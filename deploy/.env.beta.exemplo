# Modelo do .env para a INSTALACAO BETA nos PCs dos colegas.
#
# COMO USAR:
#   1. Copiar este ficheiro para  deploy\.env.beta
#   2. Nao ha nada para preencher: este ficheiro JA NAO LEVA CREDENCIAIS.
#   3. Correr o build:  .venv\Scripts\python.exe build_beta.py --installer
#
# PORQUE E QUE NAO HA AQUI PASSWORD NENHUMA
# ------------------------------------------
# Ate 2026-07-31 este ficheiro levava a password do utilizador martelo_v3, e ia
# dentro do instalador para o PC de cada colega. Quem o abrisse ligava-se a base
# por fora do Martelo e fazia o que quisesse -- promover-se a admin, ligar a
# escrita no iMos, ler as passwords do PHC -- porque as permissoes da aplicacao
# sao so da interface, nao da base de dados.
#
# Agora cada pessoa tem a SUA conta MySQL, e e ela que escreve no login. O
# servidor, a porta e o nome da base ficam aqui porque nao sao segredo nenhum;
# credenciais nunca mais.
#
# As contas criam-se com  deploy\mysql_contas_beta.sql  +
# scripts\gerar_contas_mysql.py (ver o cabecalho desses ficheiros).

APP_NAME=Martelo Orcamentos V3 (beta)
APP_ENV=beta
LOG_LEVEL=INFO

# --- Base de dados PARTILHADA do beta (servidor = PC do Paulo) ---
# Sem DB_USER nem DB_PASSWORD de proposito: as credenciais sao as que cada
# pessoa escreve no login do Martelo.
DB_DRIVER=pymysql
DB_HOST=192.168.5.201
DB_PORT=3306
DB_NAME=martelo_v3_beta
DB_CHARSET=utf8mb4

# --- Arquivo Martelo V2 (consulta só-leitura) ---
# Preencher se os colegas precisarem da consulta ao V2 durante os testes.
V2_DB_HOST=192.168.5.201
V2_DB_PORT=3306
V2_DB_NAME=orcamentos_v2
V2_DB_USER=orc_user
V2_DB_PASSWORD=POR_DEFINIR
