# Modelo do .env para a versao OFICIAL do Martelo V3.
#
# COMO USAR:
#   1. Copiar este ficheiro para  deploy\.env.producao
#   2. Confirmar o DB_HOST e o DB_NAME (e' a unica coisa que ha' para decidir)
#   3. Correr o build:  .venv\Scripts\python.exe build_beta.py --producao --installer
#
# NAO HA' AQUI CREDENCIAIS NENHUMAS, E NUNCA PODE HAVER.
# ------------------------------------------------------
# Este ficheiro vai dentro do instalador, para o PC de cada pessoa. Quem o
# abrisse com uma password la' dentro ligava-se a` base por fora do Martelo e
# fazia o que quisesse -- promover-se a admin, ligar a escrita no iMos, ler as
# passwords do PHC -- porque as permissoes da aplicacao sao so' da interface,
# nao da base de dados.
#
# Cada pessoa tem a SUA conta MySQL, e e' ela que escreve no login. O servidor,
# a porta e o nome da base ficam aqui porque nao sao segredo nenhum.
#
# As contas criam-se com  deploy\mysql_contas_beta.sql  +
# scripts\gerar_contas_mysql.py (ver o cabecalho desses ficheiros).

APP_NAME=Martelo Orcamentos V3

# "production" faz DESAPARECER o rotulo do ambiente na barra de cima. Em
# qualquer outro valor (development, beta) a janela passa a dizer em que base
# esta' a trabalhar -- que e' o que se quer nas de teste, e nao nesta.
APP_ENV=production

LOG_LEVEL=INFO

# --- Base de dados OFICIAL ---
# Sem DB_USER nem DB_PASSWORD de proposito: as credenciais sao as que cada
# pessoa escreve no login do Martelo.
#
# DB_HOST: o PC ou servidor onde vive o MySQL. Enquanto for o PC do Paulo,
#          e' o IP dele na rede -- e nao "localhost", que no PC de um colega
#          apontaria para o proprio PC dele.
DB_DRIVER=pymysql
DB_HOST=192.168.5.201
DB_PORT=3306
DB_NAME=martelo_v3
DB_CHARSET=utf8mb4

# --- Arquivo Martelo V2 (consulta so'-leitura) ---
# Preencher se os colegas precisarem de consultar os orcamentos antigos do V2.
# Esta e' a unica conta partilhada que resta; deve ser uma conta so' de leitura
# e NUNCA a mesma com que o Martelo V2 trabalha.
V2_DB_HOST=192.168.5.201
V2_DB_PORT=3306
V2_DB_NAME=orcamentos_v2
V2_DB_USER=
V2_DB_PASSWORD=
